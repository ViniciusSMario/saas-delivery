# Produção. Copie para .env no servidor e preencha os campos marcados com <...>.
# Nunca coloque este arquivo preenchido no Git.

APP_NAME="SaaS Delivery"
APP_ENV=production
APP_DEBUG=false
# Gere com: docker compose -f docker-compose.production.yml run --rm app php artisan key:generate --show
APP_KEY=<base64:...>
APP_URL=https://<seudominio.com.br>
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

# Domínios: site/cadastro, admin da plataforma e base dos subdomínios dos estabelecimentos.
TENANCY_CENTRAL_DOMAINS=<seudominio.com.br>,www.<seudominio.com.br>
TENANCY_PLATFORM_DOMAIN=admin.<seudominio.com.br>
TENANCY_BASE_DOMAIN=<seudominio.com.br>
# Papel do PostgreSQL por estabelecimento (o banco recusa acesso a outro schema).
TENANCY_DATABASE_ROLES=true

# HTTPS automático (Let's Encrypt): e-mail para avisos de certificado.
ACME_EMAIL=<voce@seudominio.com.br>
# Segredo entre o Caddy e o app. Gere com: openssl rand -hex 32
CADDY_ASK_TOKEN=<segredo-longo>

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=tenant
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=saas
DB_USERNAME=saas
DB_PASSWORD=<senha-forte-do-banco>
POSTGRES_SUPERUSER_PASSWORD=<outra-senha-forte>

SESSION_DRIVER=redis
SESSION_STORE=sessions
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail transacional (Amazon SES, Mailgun, Brevo, Resend...).
MAIL_MAILER=smtp
MAIL_HOST=<smtp.provedor.com>
MAIL_PORT=587
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<senha>
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="nao-responda@<seudominio.com.br>"
MAIL_FROM_NAME="${APP_NAME}"

# Cobrança: comece com fake; troque para asaas com as chaves de produção.
BILLING_DRIVER=fake
BILLING_GRACE_DAYS=7
ASAAS_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Backups: locais e cópia fora do servidor (S3, Backblaze B2, Cloudflare R2, Wasabi...).
BACKUPS_KEEP_DAILY=7
BACKUPS_KEEP_WEEKLY=4
BACKUPS_KEEP_OTHER_DAYS=30
BACKUPS_OFFSITE_DISK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
TENANT_DELETION_GRACE_DAYS=30

# Monitoramento de erros (sentry.io ou GlitchTip).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

PRINTING_NETWORK_ENABLED=false
